{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Owly RPM installed from GitHub releases",
      "managerFilePatterns": [
        "/^recipes/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "https://github\\.com/(?<depName>t4t5/owly)/releases/download/v(?<currentValue>[^/]+)/owly-[^/]+-1\\.x86_64\\.rpm"
      ],
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "autoReplaceStringTemplate": "https://github.com/{{{depName}}}/releases/download/v{{{newValue}}}/owly-{{{newValue}}}-1.x86_64.rpm"
    },
    {
      "customType": "regex",
      "description": "Apple emoji font pinned to a GitHub release tag",
      "managerFilePatterns": [
        "/^recipes/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "https://github\\.com/(?<depName>samuelngs/apple-emoji-ttf)/releases/download/(?<currentValue>[^/]+)/AppleColorEmoji-Linux\\.ttf"
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^macos-(?<major>\\d+)-(?<minor>\\d{8})-[0-9a-f]+$"
    },
    {
      "customType": "regex",
      "description": "talosctl pinned in the install script",
      "managerFilePatterns": [
        "/^files/scripts/.+\\.sh$/"
      ],
      "matchStrings": [
        "tag=(?<currentValue>v[^ ]+) # renovate: datasource=(?<datasource>[^ ]+) depName=(?<depName>\\S+)"
      ]
    }
  ]
}
